# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=youtube_to_article

# Redis
REDIS_URL=redis://localhost:6379

# Converter Service
CONVERTER_URL=http://localhost:8000

# AI Providers (ai-router handles fallback chain automatically)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
DEEPSEEK_API_KEY=

# API
PORT=3001
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Clerk (API) — https://dashboard.clerk.com
CLERK_SECRET_KEY=

# Token encryption for stored platform credentials (any long random string)
TOKEN_ENCRYPTION_KEY=

# GitHub (repo publishing). On connect, OWNER/articles is created if missing.
# GITHUB_TOKEN is only a fallback for direct calls to publishArticleToGitHub().
GITHUB_TOKEN=
GITHUB_REPO_NAME=articles
GITHUB_BRANCH=main
GITHUB_CONTENT_DIR=content/posts

# Google OAuth (Blogger) — https://console.cloud.google.com
# Enable "Blogger API v3", create OAuth client (Web), add redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/connections/blogger/callback

# LinkedIn OAuth (Share on LinkedIn / w_member_social)
# https://www.linkedin.com/developers/apps — add product "Share on LinkedIn".
# Standard apps: access token lasts 60 days and there is NO refresh token,
# so users must reconnect periodically.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/connections/linkedin/callback
# Posts API version header (YYYYMM). Override only if LinkedIn sunsets this one.
LINKEDIN_VERSION=202601

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
